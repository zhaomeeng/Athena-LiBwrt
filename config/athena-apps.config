# A route application overlay, applied after the author's complete native inputs.
# Native nss/docker_deps fragments and all four device profiles remain intact.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-passwall2=n
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_block-mount=y

# Requested removals, including application backends.
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_xray-core=n
CONFIG_PACKAGE_sing-box=n
CONFIG_PACKAGE_shadowsocks-rust-sslocal=n
CONFIG_PACKAGE_shadowsocks-rust-ssserver=n
CONFIG_PACKAGE_shadowsocks-rust-ssmanager=n
CONFIG_PACKAGE_shadowsocks-rust-ssservice=n
CONFIG_PACKAGE_shadowsocks-rust-ssurl=n
CONFIG_PACKAGE_shadowsocksr-libev-ssr-local=n
CONFIG_PACKAGE_simple-obfs-client=n
CONFIG_PACKAGE_v2ray-plugin=n
CONFIG_PACKAGE_rust=n
CONFIG_PACKAGE_luci-app-adguardhome=n
CONFIG_PACKAGE_adguardhome=n
CONFIG_PACKAGE_luci-app-mosdns=n
CONFIG_PACKAGE_mosdns=n
CONFIG_PACKAGE_luci-app-smartdns=n
CONFIG_PACKAGE_smartdns=n
CONFIG_PACKAGE_luci-app-easytier=n
CONFIG_PACKAGE_easytier=n
CONFIG_PACKAGE_luci-app-oaf=n
CONFIG_PACKAGE_oaf=n
CONFIG_PACKAGE_open-app-filter=n
CONFIG_PACKAGE_appfilter=n
CONFIG_PACKAGE_luci-app-pbr=n
CONFIG_PACKAGE_pbr=n
CONFIG_PACKAGE_luci-app-sqm=n
CONFIG_PACKAGE_sqm-scripts=n
CONFIG_PACKAGE_sqm-scripts-nss=n
CONFIG_PACKAGE_luci-app-vlmcsd=n
CONFIG_PACKAGE_vlmcsd=n
CONFIG_PACKAGE_luci-app-quickstart=n
CONFIG_PACKAGE_quickstart=n
CONFIG_PACKAGE_luci-app-store=n
CONFIG_PACKAGE_luci-app-istorex=n
CONFIG_PACKAGE_luci-app-quickfile=n
CONFIG_PACKAGE_taskd=n
CONFIG_PACKAGE_luci-lib-taskd=n

# Prevent additional proxy managers or online image rebuilders being selected.
CONFIG_PACKAGE_luci-app-homeproxy=n
CONFIG_PACKAGE_luci-app-ssr-plus=n
CONFIG_PACKAGE_luci-app-nikki=n
CONFIG_PACKAGE_nikki=n
CONFIG_PACKAGE_mihomo-meta=n
CONFIG_PACKAGE_luci-app-momo=n
CONFIG_PACKAGE_luci-app-attendedsysupgrade=n
